# Compose project name (determines container names: <NAME> and <NAME>-db).
# Required to be unique for multi-instance deployments on the same host (e.g. freepbx-2).
COMPOSE_PROJECT_NAME=freepbx

TZ=Europe/Moscow

# Prebuilt FreePBX image from GHCR (production docker-compose.yml).
# Pin a release: FREEPBX_IMAGE_TAG=1.2.3
FREEPBX_IMAGE_TAG=latest

# Web UI port on the host (host networking).
HTTP_PORT=8080

# MariaDB — same-host Docker Connector uses host.docker.internal:FREEPBX_DB_PORT.
# Default bind is all interfaces (like AMI); MySQL users are limited to private nets.
# Firewall TCP FREEPBX_DB_PORT (install.sh adds a ufw deny rule when ufw is active).
MYSQL_ROOT_PASSWORD=change-this-root-password
FREEPBX_DB_NAME=asterisk
FREEPBX_CDR_DB_NAME=asteriskcdrdb
FREEPBX_DB_USER=freepbx
FREEPBX_DB_PASS=change-this-password
FREEPBX_DB_PORT=3307
FREEPBX_DB_BIND=0.0.0.0
# Set to 1 only for true remote CEL/CDR clients (opens user@'%'). Same-host Docker
# does not need this — private-net grants are always enabled.
FREEPBX_DB_ALLOW_REMOTE=0

# SIP / VoIP ports
# PJSIP UDP and TCP signaling port (default: 5060)
SIP_PORT=5060
# PJSIP TLS signaling port (default: 5061)
SIPS_PORT=5061
# chan_sip legacy UDP port if enabled (default: 5160)
SIP_LEGACY_PORT=5160

# Asterisk Manager Interface (AMI).
# Bind is 0.0.0.0; keep TCP ASTERISK_AMI_PORT firewalled to localhost and trusted networks.
ASTERISK_AMI_ENABLED=1
ASTERISK_AMI_BINDADDR=0.0.0.0
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=admin
ASTERISK_AMI_PASSWORD=change-this-ami-password
# Loopback range; host interface IPs are auto-added when ASTERISK_AMI_PERMIT_HOST_IPS=1.
ASTERISK_AMI_PERMIT=127.0.0.0/255.0.0.0
# Optional extra CIDRs (comma-separated) for remote AMI clients.
# ASTERISK_AMI_PERMIT_EXTRA=203.0.113.10/255.255.255.255
ASTERISK_AMI_PERMIT_HOST_IPS=1
# Auto-permit docker0/br-* subnets so same-host compose workers work without
# hardcoding Docker bridge IPs (they change per host / compose project).
ASTERISK_AMI_PERMIT_DOCKER=1

# Asterisk internal mini-HTTP server (WebSockets/WSS/WebRTC)
ASTERISK_HTTP_PORT=8088
ASTERISK_HTTPS_PORT=8089

# Asterisk IAX2 port
ASTERISK_IAX_PORT=4569

# RTP media range — MUST be non-overlapping across instances on the same host!
# E.g. Instance 1: 10000-14999, Instance 2: 15000-19999, Instance 3: 20000-24999.
RTP_START=10000
RTP_FINISH=20000

# fail2ban (host): comma-separated IPs/CIDRs never banned for SIP auth failures.
# FAIL2BAN_IGNORE_IP=127.0.0.1/8,::1,10.0.0.0/8
