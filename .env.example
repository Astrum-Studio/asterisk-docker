TZ=Europe/Moscow

# Prebuilt FreePBX image from GHCR (production docker-compose.yml).
# Pin a release: FREEPBX_IMAGE_TAG=1.2.3
FREEPBX_IMAGE_TAG=latest

# Web UI port on the host (host networking).
HTTP_PORT=8080

# MariaDB (default: localhost only).
MYSQL_ROOT_PASSWORD=change-this-root-password
FREEPBX_DB_NAME=asterisk
FREEPBX_CDR_DB_NAME=asteriskcdrdb
FREEPBX_DB_USER=freepbx
FREEPBX_DB_PASS=change-this-password
FREEPBX_DB_PORT=3307
FREEPBX_DB_BIND=127.0.0.1
# Set to 1 only if a remote host must connect to CEL/CDR (opens user@'%').
FREEPBX_DB_ALLOW_REMOTE=0

# Asterisk Manager Interface.
# Bind is 0.0.0.0; keep TCP 5038 firewalled to localhost and trusted networks.
ASTERISK_AMI_ENABLED=1
ASTERISK_AMI_BINDADDR=0.0.0.0
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=admin
ASTERISK_AMI_PASSWORD=change-this-ami-password
# Loopback range; host interface IPs are auto-added when ASTERISK_AMI_PERMIT_HOST_IPS=1.
ASTERISK_AMI_PERMIT=127.0.0.0/255.0.0.0
# Optional extra CIDRs (comma-separated) for remote AMI clients.
# ASTERISK_AMI_PERMIT_EXTRA=203.0.113.10/255.255.255.255
ASTERISK_AMI_PERMIT_HOST_IPS=1
# Auto-permit docker0/br-* subnets so same-host compose workers work without
# hardcoding Docker bridge IPs (they change per host / compose project).
ASTERISK_AMI_PERMIT_DOCKER=1

# RTP range — keep aligned with FreePBX: Settings -> Asterisk SIP Settings -> RTP Port Ranges.
RTP_START=10000
RTP_FINISH=20000

# fail2ban (host): comma-separated IPs/CIDRs never banned for SIP auth failures.
# FAIL2BAN_IGNORE_IP=127.0.0.1/8,::1,10.0.0.0/8
